# Token del bot (obtenerlo con @BotFather en Telegram)
BOT_TOKEN=1234567890:ABCDEFghijklmnopQRSTUVwxyz

# Opcional: IDs de Telegram separados por coma para restringir acceso
# Podés ver tu ID enviando cualquier mensaje a @userinfobot
# ALLOWED_IDS=123456789,987654321

# URL pública del servicio (Render). Habilita el auto-ping anti-sleep.
# BOT_URL=https://mi-bot.onrender.com

# ─── Modo automático ──────────────────────────────────────────────────────────
# Registra la asistencia solo, en las franjas definidas en horarios.json.
# Las cuatro variables son obligatorias para que el scheduler arranque.

AUTO_LEGAJO=12345
AUTO_PASSWORD=tu-password-sysacad
AUTO_IP=0.0.0.0
AUTO_CHAT_ID=123456789

# Opcionales
# AUTO_ENABLED=false        # arranca pausado (se reanuda con /auto_on)
# AUTO_INTERVAL_SEC=60      # cada cuánto consulta durante la franja (mínimo 30)
# AUTO_FORZAR=true          # si el docente nunca habilitó, intentar igual sobre el final
# TZ_UTN=America/Argentina/Buenos_Aires
