# Token del bot (obtenerlo con @BotFather en Telegram)
BOT_TOKEN=1234567890:ABCDEFghijklmnopQRSTUVwxyz

# OBLIGATORIA. Chat ids de Telegram autorizados, separados por coma.
# El bot guarda contraseñas SYSACAD, que abren la cuenta académica entera de
# quien las presta: sin esta lista no se da de alta a nadie.
# Cada uno ve su id mandándole cualquier mensaje a @userinfobot
ALLOWED_IDS=123456789,987654321

# Clave para cifrar las contraseñas en reposo. Generala una vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Tiene que ser ESTABLE: si cambia, lo ya guardado queda ilegible.
STORE_KEY=poné-acá-la-clave-generada

# URL pública del servicio. Necesaria para /guardar_ip (el link que captura la
# IP de la red de UTN) y para el auto-ping anti-sleep de Render.
BOT_URL=https://mi-bot.onrender.com

# Opcionales
# AUTO_ENABLED=false        # arranca con el scheduler pausado
# AUTO_INTERVAL_SEC=60      # cada cuánto corre el scheduler (mínimo 30)
# AUTO_BACKOFF_MAX_MIN=3    # espera máxima entre consultas mientras no habilitan
# AUTO_FORZAR=true          # si el docente nunca habilitó, intentar igual al final
# TZ_UTN=America/Argentina/Buenos_Aires
# STORE_PATH=./store.json   # dónde vive el store
